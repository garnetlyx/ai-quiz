# Matches the host port docker-compose.yml publishes for Postgres.
DATABASE_URL=postgres://ai_quiz:ai_quiz_dev@localhost:5433/ai_quiz
JWT_SECRET=change-me-in-production
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
SEARXNG_BASE_URL=http://localhost:8080
EXA_API_KEY=
BRAVE_API_KEY=
CORS_ORIGIN=http://localhost:8081
PORT=3001

# Interface the API listens on (a tailnet IP restricts it to the tailnet)
HOST=0.0.0.0
